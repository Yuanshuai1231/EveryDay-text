# Default: persistent local PostgreSQL. Use supabase for a cloud database.
CHECKIN_STORAGE=local
# CHECKIN_DATA_DIR=C:/absolute/path/to/persistent-data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL. Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local account email delivery: preview (development only) or smtp (real email).
CHECKIN_MAIL_TRANSPORT=preview
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=

